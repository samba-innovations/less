// â”€â”€â”€ Occurrences â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model OccurrenceCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique
  color String @default("#6b7280")

  occurrences Occurrence[]
}

model Occurrence {
  id           Int                @id @default(autoincrement())
  schoolId     Int
  categoryId   Int
  reportedById Int
  handledById  Int?
  date         String
  severity     OccurrenceSeverity
  status       OccurrenceStatus   @default(RASCUNHO)
  location     String?
  description  String
  devolutiva   String?
  devolutivaAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category   OccurrenceCategory @relation(fields: [categoryId], references: [id])
  reportedBy User               @relation("OccurrenceReportedBy", fields: [reportedById], references: [id])
  handledBy  User?              @relation("OccurrenceHandledBy", fields: [handledById], references: [id])
  students   OccurrenceStudent[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([reportedById])
  @@index([schoolId, date])
}

model OccurrenceStudent {
  occurrenceId Int
  studentId    Int

  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([occurrenceId, studentId])
  @@index([studentId])
}

// --- OE (Orientacao de Estudos) ---

model LessOeMissao {
