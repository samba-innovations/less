generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€ Enums â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum SystemSlug {
  mockflow
  occurrences
  less
  control
  gate
  reserves
  guardian
  stock
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SchoolType {
  PUBLIC
  PRIVATE
}

enum EnrollmentType {
  MAIN
  ELECTIVE
}

enum GateEntryType {
  ENTRY
  LATE_ENTRY
  EXIT
  EARLY_EXIT
  CALL
}

enum PhoneType {
  FIXO
  CELULAR
}

enum MultiplicaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LessDocType {
  PLANO_AULA
  GUIA_APRENDIZAGEM
  PEI
  PLANO_ELETIVA
  PLANO_EMA
  PROJETO
  PDI
  ATA
  DECLARACAO
  COMUNICADO
  ATESTADO
  CARTA_NAUTICA
  OE_PLANO_AULA
  OE_GUIA_APRENDIZAGEM
  RELATORIO_SINTESE
  DIAGNOSTICO_TURMA
}

enum LessDocStatus {
  DRAFT
  FINAL
}

enum OccurrenceSeverity {
  LEVE
  MODERADA
  GRAVE
}

enum OccurrenceStatus {
  RASCUNHO
  REGISTRADA
  DEVOLUTIVA
  ASSINADA
  ARQUIVADA
}

// â”€â”€â”€ Ecosystem â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Ecosystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  label     String
  createdAt DateTime @default(now())

  plans         Plan[]
  organizations Organization[]
}

// â”€â”€â”€ Organization â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Organization {
  id           Int      @id @default(autoincrement())
  ecosystemId  Int
  slug         String   @unique
  name         String
  state        String   @default("")
  city         String   @default("")
  isActive     Boolean  @default(true)
  headerConfig Json?
  createdAt    DateTime @default(now())

  ecosystem      Ecosystem                 @relation(fields: [ecosystemId], references: [id])
  subscription   OrganizationSubscription?
  orgSystems     OrganizationSystem[]
  orgRoles       UserOrganizationRole[]
  notifications  Notification[]
  supportTickets SupportTicket[]
  school         School?
}

// â”€â”€â”€ OrganizationSystem â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model OrganizationSystem {
  organizationId Int
  systemId       Int
  order          Int @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system       System       @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@id([organizationId, systemId])
}

// â”€â”€â”€ System â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model System {
  id    Int        @id @default(autoincrement())
  slug  SystemSlug @unique
  label String

  planSystems PlanSystem[]
  orgSystems  OrganizationSystem[]
}

// â”€â”€â”€ Plan â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Plan {
  id          Int      @id @default(autoincrement())
  ecosystemId Int
  name        String
  description String?
  createdAt   DateTime @default(now())

  ecosystem     Ecosystem                  @relation(fields: [ecosystemId], references: [id])
  planSystems   PlanSystem[]
  subscriptions OrganizationSubscription[]
}

// â”€â”€â”€ PlanSystem â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PlanSystem {
  planId   Int
  systemId Int

  plan   Plan   @relation(fields: [planId], references: [id])
  system System @relation(fields: [systemId], references: [id])

  @@id([planId, systemId])
}

// â”€â”€â”€ School â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model School {
  id             Int        @id @default(autoincrement())
  organizationId Int        @unique
  type           SchoolType @default(PUBLIC)
  hasTutoria     Boolean    @default(false)
  hasMultiplica  Boolean    @default(false)
  openTime       String?
  closeTime      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  schoolYears         SchoolYear[]
  grades              Grade[]
  disciplines         Discipline[]
  students            Student[]
  classes             Class[]
  teacherAssignments  TeacherAssignment[]
  gateRecords         GateRecord[]
  custodyRestrictions CustodyRestriction[]
  exams               Exam[]
  examApplications    ExamApplication[]
  periods             Period[]
  timetableSlots      TimetableSlot[]
  spaces              Space[]
  reservations        Reservation[]
  occurrences         Occurrence[]
  classDisciplines    ClassDiscipline[]
  equipment           Equipment[]
  multiplicaSchedules MultiplicaSchedule[]
  lessonRecords       LessonRecord[]
  lessDocuments       LessDocument[]
  lessDocTypes        LessSchoolDocType[]
  lessPeiStudents     LessPeiStudent[]

  threads Thread[]
}

// â”€â”€â”€ OrganizationSubscription â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model OrganizationSubscription {
  id             Int                @id @default(autoincrement())
  organizationId Int                @unique
  planId         Int
  status         SubscriptionStatus @default(ACTIVE)
  startedAt      DateTime           @default(now())
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])
}

// â”€â”€â”€ User â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  passwordHash       String
  name               String
  avatarUrl          String?
  isActive           Boolean  @default(true)
  isAdmin            Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  orgRoles                 UserOrganizationRole[]
  refreshTokens            RefreshToken[]
  ssoTokens                SsoToken[]
  teacherAssignments       TeacherAssignment[]
  gateRecords              GateRecord[]
  notifications            Notification[]
  notificationPreferences NotificationPreference[]
  createdExams             Exam[]
  timetableSlots           TimetableSlot[]
  reservations             Reservation[]          @relation("UserReservations")
  approvedReservations     Reservation[]          @relation("ApprovedReservations")
  reportedOccurrences      Occurrence[]           @relation("OccurrenceReportedBy")
  handledOccurrences       Occurrence[]           @relation("OccurrenceHandledBy")
  multiplicaSchedules      MultiplicaSchedule[]   @relation("MultiplicaUser")
  multiplicaApprovals      MultiplicaSchedule[]   @relation("MultiplicaApprover")
  lessonRecords            LessonRecord[]
  lessDocuments            LessDocument[]
  lessFeedbacks            LessDocumentFeedback[] @relation("LessFeedbackCoordinator")
  supportTickets           SupportTicket[]

  @@index([email])
  @@index([isActive])

  threadParticipations ThreadParticipant[]
  messagesSent         Message[]              @relation("MessageSender")
  messageReactions MessageReaction[]
}

// â”€â”€â”€ UserOrganizationRole â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model UserOrganizationRole {
  userId         Int
  organizationId Int
  role           String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
}

// â”€â”€â”€ RefreshToken â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// â”€â”€â”€ SsoToken â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SsoToken {
  id             String     @id @default(uuid())
  userId         Int
  organizationId Int
  system         SystemSlug
  used           Boolean    @default(false)
  expiresAt      DateTime
  createdAt      DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// â”€â”€â”€ Gate â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model GateRecord {
  id          Int           @id @default(autoincrement())
  schoolId    Int
  studentId   Int
  type        GateEntryType
  recordedAt  DateTime      @default(now())
  operatorId  Int?
  note        String?

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  operator  User?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, recordedAt])
}

model CustodyRestriction {
  id            Int      @id @default(autoincrement())
  schoolId      Int
  studentId     Int
  guardianName  String
  notes         String?
  createdAt     DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
}

// â”€â”€â”€ Control â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SchoolYear {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  year      Int
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]
  exams   Exam[]
  periods Period[]
  slots   TimetableSlot[]

  @@unique([schoolId, year])
  @@index([schoolId])
}

model Grade {
  id       Int    @id @default(autoincrement())
  schoolId Int
  name     String
  level    String
  order    Int
  isActive Boolean @default(true)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]
  exams   Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Discipline {
  id             Int     @id @default(autoincrement())
  schoolId       Int
  name           String
  type           String  @default("REGULAR")
  area           String  @default("")
  grau           String  @default("")
  curriculumType String  @default("")
  aulasNome      String? @map("aulas_nome")
  isActive       Boolean @default(true)

  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments      TeacherAssignment[]
  exams            Exam[]
  slots            TimetableSlot[]
  classDisciplines ClassDiscipline[]
  lessonRecords    LessonRecord[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassDiscipline {
  id           Int @id @default(autoincrement())
  schoolId     Int
  classId      Int
  disciplineId Int
  weeklyHours  Int @default(0)

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([classId, disciplineId])
  @@index([schoolId])
}

// â”€â”€â”€ Timetable â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Period {
  id           Int     @id @default(autoincrement())
  schoolId     Int
  schoolYearId Int
  name         String
  startTime    String
  endTime      String
  order        Int
  shift        String?
  isClass      Boolean @default(true)

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear      @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  slots      TimetableSlot[]

  @@unique([schoolId, schoolYearId, order])
  @@index([schoolId, schoolYearId])
}

model TimetableSlot {
  id           Int @id @default(autoincrement())
  schoolId     Int
  schoolYearId Int
  classId      Int
  userId       Int?
  disciplineId Int
  periodId     Int
  dayOfWeek    Int
  weekParity   Int @default(0)

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  period     Period     @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([schoolId, schoolYearId, classId, periodId, dayOfWeek, weekParity])
  @@index([schoolId, schoolYearId])
  @@index([classId])
  @@index([userId])
}

model Class {
  id           Int      @id @default(autoincrement())
  schoolId     Int
  schoolYearId Int
  gradeId      Int
  name         String
  shift        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear       SchoolYear        @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  grade            Grade             @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  enrollments      StudentEnrollment[]
  assignments      TeacherAssignment[]
  examApplications ExamApplication[]
  timetableSlots   TimetableSlot[]
  classDisciplines ClassDiscipline[]
  lessonRecords    LessonRecord[]

  @@unique([schoolId, schoolYearId, gradeId, name])
  @@index([schoolId])
  @@index([schoolYearId])
}

model Student {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  name      String
  ra        String?
  birthDate DateTime?
  guardian  String?
  photoUrl  String?
  source    String    @default("manual")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments         StudentEnrollment[]
  gateRecords         GateRecord[]
  custodyRestrictions CustodyRestriction[]
  occurrences         OccurrenceStudent[]
  responsibles        Responsible[]
  lessonAbsences      LessonAbsence[]

  @@index([schoolId])
  @@index([schoolId, ra])
}

// â”€â”€â”€ ResponsÃ¡veis â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Responsible {
  id        Int       @id @default(autoincrement())
  studentId Int
  name      String
  relation  String
  phone     String
  phoneType PhoneType @default(CELULAR)
  order     Int       @default(1)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// â”€â”€â”€ Equipamentos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Equipment {
  id          Int     @id @default(autoincrement())
  schoolId    Int
  name        String
  type        String
  description String?
  quantity    Int     @default(1)
  isActive    Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

// â”€â”€â”€ Multiplica SP â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MultiplicaSchedule {
  id           Int              @id @default(autoincrement())
  userId       Int
  schoolId     Int
  dayOfWeek    Int
  startTime    String
  endTime      String
  status       MultiplicaStatus @default(PENDING)
  approvedById Int?
  createdAt    DateTime         @default(now())

  user       User   @relation("MultiplicaUser", fields: [userId], references: [id], onDelete: Cascade)
  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("MultiplicaApprover", fields: [approvedById], references: [id], onDelete: SetNull)

