// â”€â”€â”€ DiÃ¡rio de Classe â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model LessonRecord {
  id           Int      @id @default(autoincrement())
  schoolId     Int
  classId      Int
  disciplineId Int
  userId       Int
  bimestreId   Int
  date         String
  content      String
  classesGiven Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  absences   LessonAbsence[]

  @@index([schoolId, classId])
  @@index([userId])
  @@index([bimestreId])
}

model LessonAbsence {
  id             Int @id @default(autoincrement())
  lessonRecordId Int
  studentId      Int

  lessonRecord LessonRecord @relation(fields: [lessonRecordId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonRecordId, studentId])
  @@index([studentId])
}

model StudentEnrollment {
  id        Int            @id @default(autoincrement())
  studentId Int
  classId   Int
  type      EnrollmentType @default(MAIN)
  createdAt DateTime       @default(now())

  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  responses StudentResponse[]

  @@unique([studentId, classId])
  @@index([classId])
}

// â”€â”€â”€ Notification â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id             Int                   @id @default(autoincrement())
  userId         Int
  organizationId Int
  type           String
  priority       NotificationPriority  @default(NORMAL)
  title          String
  body           String
  link           String?
  read           Boolean               @default(false)
  system         String?
  meta           Json?
  dedupKey       String?
  deliveredAt    DateTime?
  seenAt         DateTime?
  createdAt      DateTime              @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, dedupKey, createdAt])
}

model NotificationPreference {
  userId    Int
  type      String
  inApp     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@index([userId])
}

model TeacherAssignment {
  id                Int     @id @default(autoincrement())
  userId            Int
  schoolId          Int
  classId           Int
  disciplineId      Int
  isRoomCoordinator Boolean @default(false)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@unique([userId, classId, disciplineId])
  @@index([userId, schoolId])
  @@index([classId])
}

// â”€â”€â”€ Mockflow â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  FINISHED
}

model Exam {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  createdBy    Int
  title        String
  description  String?
  disciplineId Int?
  gradeId      Int?
  schoolYearId Int?
  optionsCount Int        @default(4)
  status       ExamStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id])
  discipline   Discipline?  @relation(fields: [disciplineId], references: [id])
  grade        Grade?       @relation(fields: [gradeId], references: [id])
  schoolYear   SchoolYear?  @relation(fields: [schoolYearId], references: [id])
  questions    ExamQuestion[]
  applications ExamApplication[]

  @@index([schoolId])
  @@index([createdBy])
  @@index([status])
}

model ExamQuestion {
  id       Int     @id @default(autoincrement())
  examId   Int
  number   Int
  stem     String
  imageUrl String?
  optionA  String
  optionB  String
  optionC  String
  optionD  String
  optionE  String?
  answer   String

  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers StudentAnswer[]

  @@unique([examId, number])
  @@index([examId])
}

model ExamApplication {
  id        Int               @id @default(autoincrement())
  examId    Int
  classId   Int
  schoolId  Int
  date      DateTime
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  exam      Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  class     Class             @relation(fields: [classId], references: [id])
  school    School            @relation(fields: [schoolId], references: [id])
  responses StudentResponse[]

  @@unique([examId, classId])
  @@index([examId])
  @@index([classId, schoolId])
}

model StudentResponse {
  id            Int      @id @default(autoincrement())
  applicationId Int
  enrollmentId  Int
  score         Int?
  submittedAt   DateTime @default(now())

  application ExamApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  enrollment  StudentEnrollment @relation(fields: [enrollmentId], references: [id])
  answers     StudentAnswer[]

  @@unique([applicationId, enrollmentId])
  @@index([applicationId])
}

model StudentAnswer {
  id         Int      @id @default(autoincrement())
  responseId Int
  questionId Int
  answer     String
  isCorrect  Boolean?

  response StudentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question ExamQuestion    @relation(fields: [questionId], references: [id])

  @@unique([responseId, questionId])
  @@index([questionId])
}

// â”€â”€â”€ Reserves â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Space {
  id          Int      @id @default(autoincrement())
  schoolId    Int
  name        String
  description String?
  capacity    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Reservation {
  id           Int               @id @default(autoincrement())
  schoolId     Int
  spaceId      Int
  userId       Int
  date         String
  startTime    String
  endTime      String
  title        String
  description  String?
  status       ReservationStatus @default(PENDING)
  approvedById Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  space      Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user       User    @relation("UserReservations", fields: [userId], references: [id])
  approvedBy User?   @relation("ApprovedReservations", fields: [approvedById], references: [id])

  @@index([schoolId])
  @@index([spaceId, date])
  @@index([userId])
  @@index([status])
}

// â”€â”€â”€ Support â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum TicketStatus {
  OPEN
  CLOSED
}

model SupportTicket {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  system         String
  subject        String
  status         TicketStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     SupportMessage[]

  @@index([userId, system])
  @@index([organizationId, system])
}

model SupportMessage {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  body         String
  authorId     Int
  authorName   String
  isFromAdmin  Boolean  @default(false)
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// â”€â”€â”€ Less â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model LessSchoolDocType {
  id        Int         @id @default(autoincrement())
  schoolId  Int
  docType   LessDocType
  isEnabled Boolean     @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, docType])
  @@index([schoolId])
}

model LessDocument {
  id        Int           @id @default(autoincrement())
  schoolId  Int
  userId    Int
  type      LessDocType
  title     String
  content   Json          @default("{}")
  pdfPath   String?
  status    LessDocStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?     @map("deleted_at")

  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks LessDocumentFeedback[]

  @@index([schoolId])
  @@index([userId])
  @@index([schoolId, type])
  @@index([schoolId, status])
  @@index([schoolId, userId])
}

model LessDocumentFeedback {
  id            Int      @id @default(autoincrement())
  documentId    Int
  coordinatorId Int
  text          String
  createdAt     DateTime @default(now())

  document    LessDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  coordinator User         @relation("LessFeedbackCoordinator", fields: [coordinatorId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// â”€â”€â”€ Less Curriculum â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model LessAula {
  id                 Int     @id @default(autoincrement())
  ciclo              String  @db.VarChar(30)
  serie              String  @db.VarChar(10)
  bimestre           Int
  aulaNum            Int     @map("aula_num")
  disciplinaNome     String  @db.VarChar(200) @map("disciplina_nome")
  eixo               String? @db.VarChar(400)
  unidadeTematica    String? @map("unidade_tematica")
  habilidadeCodigo   String? @map("habilidade_codigo")
  habilidadeTexto    String? @db.Text @map("habilidade_texto")
  objetoConhecimento String? @db.VarChar(400) @map("objeto_conhecimento")
  titulo             String  @db.VarChar(400)
  conteudo           String? @db.Text
  objetivos          String? @db.Text
  bloco              String? @db.VarChar(200)

  @@unique([disciplinaNome, ciclo, serie, bimestre, aulaNum])
  @@index([disciplinaNome])
  @@index([ciclo, serie, bimestre])
  @@map("less_aulas")
}

model LessPeiStudent {
  id               Int      @id @default(autoincrement())
  schoolId         Int      @map("school_id")
  name             String   @db.VarChar(200)
  ra               String   @db.VarChar(32)
  turma            String   @db.VarChar(20)
  diagnostico      String?  @db.VarChar(200)
  profColaborativo String?  @db.VarChar(100) @map("prof_colaborativo")
  profAee          String?  @db.VarChar(100) @map("prof_aee")
  dataNascimento   String?  @db.VarChar(20)  @map("data_nascimento")
  ativo            Boolean  @default(true)
  studentId        Int?     @map("student_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt       @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([turma])
  @@map("less_pei_students")
}

model LessAprendizagemEssencial {
  id             Int    @id @default(autoincrement())
  codigo         String @db.VarChar(20)
  descricao      String @db.Text
  disciplinaNome String @db.VarChar(200) @map("disciplina_nome")
  ciclo          String @db.VarChar(30)
  serie          String @db.VarChar(10)
  bimestre       Int
  descritores          String[] @default([])
  habilidadePriorizada String?  @db.VarChar(20) @map("habilidade_priorizada")

  @@unique([codigo, disciplinaNome, ciclo, serie, bimestre])
  @@index([disciplinaNome, ciclo, serie, bimestre])
  @@map("less_aprendizagens_essenciais")
}

// ─── Relatório-Síntese (dados de referência, globais) ───
